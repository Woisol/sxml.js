{
  "name": "@woisol-g/sxml.js",
  "version": "0.3.0",
  "description": "Streaming XML parser for LLM output — incremental chunk input, structured event output",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/sxml.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "clean:dist": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "webpack --config webpack.config.cjs",
    "build": "pnpm clean:dist && pnpm build:types && pnpm build:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "pnpm typecheck && node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx project/demo/demo.js",
    "check": "pnpm lint:fix && pnpm test",
    "prepare": "husky",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "keywords": [
    "xml",
    "streaming",
    "llm",
    "parser",
    "sax",
    "incremental"
  ],
  "author": "Woisol",
  "license": "ISC",
  "homepage": "https://github.com/woisol/sxml.js#readme",
  "bugs": {
    "url": "https://github.com/woisol/sxml.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woisol/sxml.js.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "ts-loader": "^9.5.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}